{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://learning-system.local/schema/question.schema.json",
  "title": "Question",
  "description": "An assessment unit (question, subquestion or component) as segmented from a paper. Retains the verbatim extracted wording and structural metadata; classification into families/models is not part of the canonical text (IMPLEMENTATION_SPEC Phase 5).",
  "type": "object",
  "properties": {
    "question_id": {
      "type": "string",
      "pattern": "^[A-Z]+-",
      "description": "Stable identifier, e.g. BIO-2024-T2-Q3.1."
    },
    "source_id": {
      "type": "string",
      "pattern": "^SOURCE-",
      "description": "Provenance link to the source record."
    },
    "subject": {
      "type": "string",
      "enum": ["biology", "physics", "history", "english", "ap_mathematics", "mathematics"]
    },
    "grade": {
      "type": "string",
      "description": "Grade level, e.g. '11'."
    },
    "paper_id": {
      "type": ["string", "null"],
      "description": "Identifier of the paper this question belongs to."
    },
    "section": {
      "type": ["string", "null"],
      "description": "Container section, e.g. 'A' or 'SECTION B'."
    },
    "page": {
      "type": ["integer", "null"],
      "description": "Source page the question appears on."
    },
    "question_number": {
      "type": ["string", "integer", "null"],
      "description": "Top-level question number as printed."
    },
    "parent_question": {
      "type": ["string", "null"],
      "description": "Parent question_id for subcomponents."
    },
    "verbatim_text": {
      "type": "string",
      "description": "The original extracted wording. Must never be rewritten or 'corrected'."
    },
    "marks": {
      "type": ["number", "integer", "null"],
      "description": "Mark allocation, when stated."
    },
    "associated_figure": {
      "type": ["string", "null"],
      "description": "Figure/diagram reference if any."
    },
    "associated_table": {
      "type": ["string", "null"],
      "description": "Table reference if any."
    },
    "topic": {
      "type": ["string", "null"],
      "description": "Curriculum topic (mapping only; source of truth is the curriculum)."
    },
    "subtopic": {
      "type": ["string", "null"],
      "description": "Curriculum subtopic."
    },
    "question_family": {
      "type": ["string", "null"],
      "description": "Assigned question family id (fill during classification)."
    },
    "question_type": {
      "type": ["string", "null"],
      "description": "Assigned question type."
    },
    "assessment_operation": {
      "type": ["string", "null"],
      "description": "The assessment operation the wording demands."
    },
    "required_knowledge": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Knowledge items a student must know to answer."
    },
    "required_prerequisites": {
      "type": "array",
      "items": { "type": "string" }
    },
    "required_reasoning": {
      "type": "array",
      "items": { "type": "string" }
    },
    "required_method": {
      "type": ["string", "null"]
    },
    "evidence_of_understanding": {
      "type": "array",
      "items": { "type": "string" }
    },
    "marking_criteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "common_breakdowns": {
      "type": "array",
      "items": { "type": "string" }
    },
    "diagnostic_questions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "source_evidence": {
      "type": "array",
      "items": { "type": "string" },
      "description": "IDs of source/memo evidence supporting this record."
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low", "unknown"]
    },
    "validation_status": {
      "type": "string",
      "enum": ["unvalidated", "draft", "validated", "unresolved"]
    }
  },
  "required": ["question_id", "source_id", "subject", "grade", "verbatim_text"],
  "additionalProperties": false
}
